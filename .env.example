# Copy to .env.local for development. Never commit real values (.env* is
# gitignored). See docs/ARCHITECTURE.md for what each vendor is used for.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, bypasses RLS. Only used by
# src/lib/supabase/admin.ts (aggregation job, PDF report generator, the
# Twilio status webhook). Never expose to the client, never use it for a
# per-user request path.
SUPABASE_SERVICE_ROLE_KEY=

# --- App / tenancy ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ROOT_DOMAIN=neverthrowinthetowel.uk

# --- Twilio (Ask for Support SMS -- see src/lib/support/alert.ts) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS URL Twilio calls back with delivery status. Must match
# src/app/api/webhooks/twilio-status/route.ts's deployed URL.
TWILIO_STATUS_CALLBACK_URL=

# --- Brevo (transactional email + CRM -- see src/lib/support/alert.ts) ---
# Also powers the 90-day impact-report email and the step-challenge
# notifications; unset = all outbound email silently no-ops. This is the Brevo
# v3 REST api-key, used by the app's own fetch() senders.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Supabase Auth SMTP password: the Brevo *SMTP key* (Brevo -> SMTP & API ->
# SMTP), a DIFFERENT credential from BREVO_API_KEY above. Consumed by
# supabase/config.toml [auth.email.smtp] (pass = env(...)) so Supabase Auth
# sends invites / confirmation / magic-link / recovery mail through Brevo instead
# of the throttled built-in mailer. Set this in the Supabase project (or the
# dashboard's Auth -> SMTP Settings) at go-live. For local `supabase start` that
# should NOT send real mail, set [auth.email.smtp].enabled = false in
# supabase/config.toml to use the bundled Inbucket inbox. See docs/SMTP_SETUP.md.
# NOTE: this is read by the Supabase CLI/platform, not by the Next.js app.
SUPABASE_AUTH_SMTP_PASS=

# --- Ask for Support escalation (Phase 5 hardening) ---
# Global NTITT fallback contact (Anthony/Craig), used ONLY when a company's
# own support contact can't be reached (dispatch failed, delivery failed,
# or no acknowledgment within the response-time window) -- not a per-company
# setting. See src/lib/support/alert.ts's escalateSupportRequest.
NTITT_FALLBACK_CONTACT_PHONE=
NTITT_FALLBACK_CONTACT_EMAIL=

# The crisis line shown on every Ask for Support screen ("If this is urgent
# right now, please call ..."), not any one company's own contact. Leave
# unset to use the built-in default (Samaritans, 116 123) -- see
# src/lib/support/helpline.ts. Only set this to replace it with a different
# number, not to duplicate the same default.
HELPLINE_NUMBER=
# Signs the "mark as contacted" link included in every alert
# (src/app/api/support-requests/[id]/ack) -- generate a random value, never
# reuse another secret for this.
SUPPORT_ACK_TOKEN_SECRET=

# --- AI Studio assist (optional -- see src/lib/ai/client.ts) ---
# Powers the super-admin "suggest theme, day & tags" helper in the content
# Studio. Unset = the feature degrades to a message; manual authoring is
# unaffected. ANTHROPIC_MODEL defaults to claude-opus-5 if unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Aggregation job (see src/app/api/jobs/aggregate-participation) ---
# Set this in Vercel's project settings too -- Vercel Cron then sends it
# automatically as `Authorization: Bearer $CRON_SECRET` on every scheduled
# invocation (see vercel.json). Generate a random value; never reuse another
# secret for this.
CRON_SECRET=

# --- Web Push (PWA notifications -- Phase 9) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# The VAPID protocol requires a contact address in the signed request
# headers ("who to reach if a push service provider needs to reach the
# sender") -- must be a mailto: address or an https: URL; web-push's own
# validation rejects anything else, including NEXT_PUBLIC_SITE_URL's local
# dev value (http://localhost:3000 is not https:). See
# src/lib/notifications/sendPush.ts.
VAPID_SUBJECT=mailto:support@ntitt.co.uk
